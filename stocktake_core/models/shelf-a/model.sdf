<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shelf-a">
	<static>true</static>

	<link name="link">
      <collision name="collision">
	    <pose degrees="true">0.5 0.25 1.1 0 0 0</pose>
        <geometry>
          <box>
			<size>1 0.5 2.2</size>
          </box>
        </geometry>
      </collision>

	  <visual name="visual">
		  <pose degrees="true">1 0 0 90 0 90</pose>
        <geometry>
          <mesh>
            <uri>model://shelf-a/meshes/shelf-a.glb</uri>
		</mesh>
        </geometry>
	</visual>

    </link>
  </model>
</sdf>
