<?xml version="1.0"?>
<sdf version="1.9">
  <model name="counter">
	<static>true</static>

	<link name="link">
		<collision name="collision">
			<pose degrees="true">0.5 2 0.5 0 0 0</pose>
        <geometry>
          <box>
			<size>1 4 1 0 0 0</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
		  <pose degrees="true">0 0 0 90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://counter/meshes/bench.glb</uri>
		</mesh>
        </geometry>
		</visual>

    </link>
  </model>
</sdf>
